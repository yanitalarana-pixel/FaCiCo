<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PsicoMatch Toluca - Directorio Clínico</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <style>
        #map { height: 420px; width: 100%; z-index: 10; border-radius: 0.75rem; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col">

    <!-- Header -->
    <header class="bg-blue-900 text-white shadow-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <div class="bg-blue-800 p-2 rounded-lg border border-blue-700">
                    <svg class="w-6 h-6 text-blue-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                </div>
                <div>
                    <h1 class="text-xl font-bold tracking-tight">PsicoMatch Toluca</h1>
                    <p class="text-xs text-blue-200">Plataforma Segura de Emparejamiento Clínico</p>
                </div>
            </div>
            <div id="auth-status" class="flex items-center space-x-3 text-sm">
                <span id="user-badge" class="bg-blue-800 text-blue-100 px-3 py-1 rounded-full font-medium border border-blue-700">Modo Demo: Consultante</span>
                <button onclick="toggleLock()" class="bg-blue-700 hover:bg-blue-600 text-white px-3 py-1.5 rounded-lg transition text-xs font-semibold flex items-center space-x-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                    <span id="lock-text">Bloquear Sesión</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-7xl mx-auto px-4 py-8 flex-grow grid grid-cols-1 lg:grid-cols-12 gap-8 w-full">
        
        <!-- Panel Izquierdo: Perfil y Criterios del Consultante -->
        <section class="lg:col-span-4 bg-white p-6 rounded-xl shadow-sm border border-slate-200 space-y-6">
            <div>
                <h2 class="text-lg font-bold text-blue-900 flex items-center space-x-2">
                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                    <span>Mi Perfil de Consultante</span>
                </h2>
                <p class="text-xs text-slate-500 mt-1">Configura tus necesidades para encontrar el match ideal en Toluca.</p>
            </div>

            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Nombre del Consultante</label>
                    <input type="text" id="consultant-name" value="Valeria Gómez" class="w-full text-sm bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Edad</label>
                        <input type="number" id="consultant-age" value="26" class="w-full text-sm bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Presupuesto Máx ($/Sesión)</label>
                        <input type="number" id="consultant-budget" value="700" class="w-full text-sm bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Motivo de Consulta Principal</label>
                    <select id="consultant-issue" class="w-full text-sm bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="Ansiedad">Ansiedad y Estrés Laboral / Académico</option>
                        <option value="Depresión">Depresión y Estado de Ánimo</option>
                        <option value="Pareja">Terapia de Pareja y Relaciones</option>
                        <option value="Autoestima">Autoestima y Desarrollo Personal</option>
                        <option value="Duelo">Duelo y Pérdidas</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Zona en Toluca de Lerdo</label>
                    <select id="consultant-zone" class="w-full text-sm bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="Centro">Centro Histórico, Toluca</option>
                        <option value="Colon">Residencial Colón / Venustiano Carranza</option>
                        <option value="Cipres">Ciprés / San Sebastián</option>
                        <option value="Metepec">Límite Metepec - Toluca</option>
                        <option value="UAEM">Zona CU UAEMéx / Tollocan</option>
                    </select>
                </div>

                <button onclick="runMatching()" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 rounded-lg text-sm transition shadow-sm flex items-center justify-center space-x-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    <span>Calcular Match en Toluca</span>
                </button>
            </div>

            <div class="border-t border-slate-200 pt-4">
                <h3 class="text-xs font-bold uppercase text-slate-400 tracking-wider mb-2">Seguridad y Cifrado</h3>
                <div class="bg-blue-50 border border-blue-100 rounded-lg p-3 text-xs text-blue-900 space-y-1">
                    <p class="font-semibold flex items-center"><span class="w-2 h-2 bg-emerald-500 rounded-full mr-1.5"></span> Base de datos sincronizada</p>
                    <p class="text-blue-700">Tus datos y expedientes de consultante están protegidos con candado individual.</p>
                </div>
            </div>
        </section>

        <!-- Panel Derecho: Mapa, Indicadores y Resultados -->
        <section class="lg:col-span-8 space-y-6">
            
            <!-- Indicadores Clave -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                    <p class="text-xs font-semibold text-slate-500">Psicólogos en Área</p>
                    <p class="text-2xl font-bold text-blue-900 mt-1" id="stat-total">4 Activos</p>
                    <p class="text-xs text-emerald-600 mt-1 font-medium">Toluca de Lerdo</p>
                </div>
                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                    <p class="text-xs font-semibold text-slate-500">Costo Promedio Zona</p>
                    <p class="text-2xl font-bold text-blue-900 mt-1">$620 MXN</p>
                    <p class="text-xs text-slate-500 mt-1">Por sesión de 50 min</p>
                </div>
                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                    <p class="text-xs font-semibold text-slate-500">Match Máximo</p>
                    <p class="text-2xl font-bold text-emerald-600 mt-1" id="stat-max-match">98%</p>
                    <p class="text-xs text-slate-500 mt-1">Compatibilidad clínica</p>
                </div>
            </div>

            <!-- Mapa Interactivo Leaflet -->
            <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm space-y-3">
                <div class="flex justify-between items-center">
                    <h3 class="text-sm font-bold text-slate-800 flex items-center space-x-1">
                        <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path></svg>
                        <span>Geolocalización de Consultorios en Toluca de Lerdo</span>
                    </h3>
                    <span class="text-xs bg-slate-100 text-slate-600 px-2 py-1 rounded font-medium">Radio: 8 km</span>
                </div>
                <!-- Contenedor con altura explícita para evitar errores de renderizado Leaflet -->
                <div id="map"></div>
                <p class="text-xs text-slate-400 text-center">Haz clic en los marcadores del mapa para ver detalles y agendar con el especialista.</p>
            </div>

            <!-- Lista de Resultados de Match -->
            <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm space-y-4">
                <div class="flex justify-between items-center">
                    <h3 class="text-base font-bold text-blue-900">Especialistas Sugeridos para el Consultante</h3>
                    <span class="text-xs text-slate-500 font-medium">Ordenado por Match Clínico</span>
                </div>

                <div id="psychologists-list" class="space-y-4">
                    <!-- Inyección dinámica -->
                </div>
            </div>

        </section>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 py-4 text-center text-xs text-slate-500">
        <p>PsicoMatch Toluca &bull; Sistema Protegido con Autenticación &bull; Toluca, Estado de México</p>
    </footer>

    <!-- Script de Inicialización y Lógica -->
    <script>
        // Base de datos de psicólogos en Toluca de Lerdo
        const psychologists = [
            {
                id: 1,
                name: "Dra. Sofía Morales H.",
                lat: 19.2885,
                lng: -99.6532,
                zone: "Centro",
                experience: 9,
                approach: "Cognitivo-Conductual",
                specialty: "Ansiedad",
                cost: 650,
                rating: 4.9,
                cert: "Céd. Prof. 8493021 / UNAM",
                address: "Av. Benito Juárez 305, Centro, Toluca"
            },
            {
                id: 2,
                name: "Mtro. Alejandro Rivas",
                lat: 19.2740,
                lng: -99.6380,
                zone: "Colon",
                experience: 12,
                approach: "Sistémico / Parejas",
                specialty: "Pareja",
                cost: 800,
                rating: 4.8,
                cert: "Céd. Prof. 5291043 / UAEMéx",
                address: "Paseo Tollocan Ote. 1200, Residencial Colón"
            },
            {
                id: 3,
                name: "Dra. Carmen Valencia",
                lat: 19.2920,
                lng: -99.6600,
                zone: "Cipres",
                experience: 6,
                approach: "Humanista Gestalt",
                specialty: "Autoestima",
                cost: 500,
                rating: 4.7,
                cert: "Céd. Prof. 9182734 / IBERO",
                address: "Calle Ciprés 104, Col. Ciprés, Toluca"
            },
            {
                id: 4,
                name: "Lic. Daniel Mendoza",
                lat: 19.2810,
                lng: -99.6700,
                zone: "UAEM",
                experience: 5,
                approach: "Cognitivo-Conductual",
                specialty: "Depresión",
                cost: 450,
                rating: 4.9,
                cert: "Céd. Prof. 7482910 / UAEMéx",
                address: "Cercano a CU UAEMéx, Toluca"
            }
        ];

        // Inicializar Mapa Leaflet centrado en Toluca de Lerdo
        let map = L.map('map').setView([19.2826, -99.6557], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);

        let markers = [];

        function renderMapAndList(filteredList = psychologists) {
            // Limpiar marcadores anteriores
            markers.forEach(m => map.removeLayer(m));
            markers = [];

            const listContainer = document.getElementById('psychologists-list');
            listContainer.innerHTML = '';

            if (filteredList.length === 0) {
                listContainer.innerHTML = `<p class="text-sm text-slate-500 text-center py-6">No se encontraron especialistas con los criterios exactos en esta zona.</p>`;
                document.getElementById('stat-total').innerText = '0 Activos';
                document.getElementById('stat-max-match').innerText = '0%';
                return;
            }

            document.getElementById('stat-total').innerText = `${filteredList.length} Activos`;
            
            let maxMatch = 0;

            filteredList.forEach((psy, index) => {
                // Cálculo de match simulado basado en presupuesto y especialidad
                const consultantBudget = parseInt(document.getElementById('consultant-budget').value) || 700;
                const consultantIssue = document.getElementById('consultant-issue').value;
                
                let score = 75;
                if (psy.cost <= consultantBudget) score += 15;
                if (psy.specialty === consultantIssue) score += 10;
                if (score > 98) score = 98;

                if (score > maxMatch) maxMatch = score;

                // Agregar marcador al mapa
                let marker = L.marker([psy.lat, psy.lng]).addTo(map)
                    .bindPopup(`<b>${psy.name}</b><br>${psy.specialty}<br>Costo: $${psy.cost} MXN`);
                markers.push(marker);

                // Renderizar tarjeta en HTML
                const card = document.createElement('div');
                card.className = "bg-slate-50 border border-slate-200 rounded-xl p-4 hover:border-blue-300 transition flex flex-col md:flex-row justify-between items-start md:items-center gap-4";
                card.innerHTML = `
                    <div class="space-y-1">
                        <div class="flex items-center space-x-2">
                            <h4 class="font-bold text-slate-900 text-sm">${psy.name}</h4>
                            <span class="bg-emerald-100 text-emerald-800 text-xs px-2 py-0.5 rounded-full font-semibold">${score}% Match</span>
                        </div>
                        <p class="text-xs text-slate-600 font-medium">Especialidad: <span class="text-blue-700">${psy.specialty}</span> &bull; Enfoque: ${psy.approach}</p>
                        <p class="text-xs text-slate-500">${psy.address} &bull; <b>${psy.experience} años exp.</b></p>
                        <p class="text-xs text-slate-400">${psy.cert}</p>
                    </div>
                    <div class="flex flex-col items-end space-y-2 w-full md:w-auto">
                        <span class="text-sm font-bold text-blue-900">$${psy.cost} MXN <span class="text-xs font-normal text-slate-500">/sesión</span></span>
                        <button onclick="alert('Cita solicitada con éxito para el consultante con ${psy.name}. Se ha guardado en el sistema seguro.')" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-1.5 rounded-lg text-xs font-semibold transition w-full md:w-auto text-center">
                            Agendar Cita
                        </button>
                    </div>
                `;
                listContainer.appendChild(card);
            });

            document.getElementById('stat-max-match').innerText = `${maxMatch}%`;
        }

        function runMatching() {
            const selectedZone = document.getElementById('consultant-zone').value;
            // Filtrar o priorizar según zona
            renderMapAndList(psychologists);
        }

        let isLocked = false;
        function toggleLock() {
            isLocked = !isLocked;
            const lockText = document.getElementById('lock-text');
            const userBadge = document.getElementById('user-badge');
            if (isLocked) {
                lockText.innerText = "Desbloquear";
                userBadge.innerText = "Sesión Bloqueada (Candado Activo)";
                userBadge.className = "bg-amber-100 text-amber-800 px-3 py-1 rounded-full font-medium border border-amber-200";
            } else {
                lockText.innerText = "Bloquear Sesión";
                userBadge.innerText = "Modo Demo: Consultante";
                userBadge.className = "bg-blue-800 text-blue-100 px-3 py-1 rounded-full font-medium border border-blue-700";
            }
        }

        // Cargar al iniciar y corregir tamaño de mapa Leaflet tras renderizado
        window.onload = function() {
            renderMapAndList();
            setTimeout(() => {
                map.invalidateSize();
            }, 300);
        };
    </script>
</body>
</html>
            
